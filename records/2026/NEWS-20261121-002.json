      "fact_id": "NEWS-20261121-002-F2",
      "text": "국제표준 AAS 구조 표준 IEC 63278-1을 기반으로 설비의 사용 목적에 맞는 양식 선택과 기술·운영데이터 정보구조 구성·확장 방법을 설명한다.",
      "source_urls": [
        "https://www.motir.go.kr/kor/article/ATCL3f49a5a8c/172429/view?mno=&pageIndex=1"
      ],
      "evidence_locator": "보도자료 본문 2~3문단",
      "claim_type": "confirmed_fact"
    },
